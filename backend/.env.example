# Sao chép file này thành .env (cùng thư mục) và dán key thật vào.
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=<dan-key-vao-day>

# CSDL: mặc định SQLite (file algosim.db, không cần cài gì).
# Muốn dùng PostgreSQL: bỏ dấu # dòng dưới, sửa thông tin kết nối,
# và cài driver: .venv\Scripts\pip install psycopg2-binary
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/algosim

# Tuyến chính thức Hybrid `/4`:
# - live (mặc định): trích xuất có cấu trúc qua Gemini (`typed-fact-next/2`) khi có `GEMINI_API_KEY`
# - staging-replay: chạy Hybrid `/4` với kho trích xuất đã ghi (`HYBRID_REPLAY_CORPUS`)
# HYBRID_ROUTE_MODE=live
# HYBRID_REPLAY_CORPUS=
# ALLOW_LIVE_AI=0  # tuỳ chọn: đặt =0 nếu muốn chủ động khoá kết nối live AI trên máy chủ

# Cấu hình tài khoản Quản trị (Admin) — chỉ khai báo biến mẫu, KHÔNG lưu mật khẩu thật trong Git.
# Admin đăng nhập trên giao diện chung bằng ADMIN_USERNAME (mặc định: admin) hoặc ADMIN_EMAIL
# (cả hai ánh xạ tới cùng một tài khoản role=admin trong CSDL).
# Điền ADMIN_PASSWORD KHÔNG tạo tài khoản: backend không bao giờ tự tạo/đổi Admin khi khởi động.
# Chạy công cụ trên CÙNG CSDL mà backend dùng (kiểm tra trước bằng --check, chỉ đọc):
#   Docker Compose : docker compose up -d --force-recreate backend   (nạp lại .env vào container)
#                    docker compose exec backend python scripts/manage_admin.py --check
#                    docker compose exec backend python scripts/manage_admin.py --apply --create-if-missing
#   Chạy trực tiếp : python scripts/manage_admin.py --check   (không có DATABASE_URL => SQLite backend/algosim.db)
ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@axo.edu.vn
ADMIN_PASSWORD=

# Model & vận hành production (không đưa bí mật vào Git):
# GEMINI_MODEL=gemini-2.5-flash
# CORS_ALLOW_ORIGINS=https://hoclieu.tech,https://www.hoclieu.tech
# COOKIE_SECURE=1
# COOKIE_SAMESITE=lax
# TRUST_PROXY_HEADERS=1
# UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=15
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# DB_POOL_RECYCLE=1800
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ── Email giao dịch (xác minh email, quên/đặt lại mật khẩu, thông báo đổi mật khẩu) ──
# Nhà cung cấp chính thức: Resend (REST API). Thiếu cấu hình => tính năng ở trạng thái KHÔNG KHẢ DỤNG
# (không gửi, không giả vờ đã gửi; đăng nhập và mô phỏng vẫn hoạt động).
# - Local: giữ EMAIL_ENABLED=false nếu không cần gửi thư thật.
# - Production: EMAIL_ENABLED=true, RESEND_API_KEY lấy từ secret manager của VPS (KHÔNG commit),
#   ALGOSIM_PUBLIC_APP_URL=https://hoclieu.tech (liên kết trong thư luôn dựng từ biến này, không từ Host header).
# Kiểm tra cấu hình (không in khoá):  python scripts/email_smoke_test.py --check
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Axo <noreply@mail.hoclieu.tech>"
EMAIL_ENABLED=false
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
ALGOSIM_PUBLIC_APP_URL=http://localhost:3000
# Giới hạn khối lượng thư mỗi tiến trình (chống dội thư): mặc định 5 thư/người nhận/giờ, 200 thư/giờ.
# EMAIL_MAX_PER_RECIPIENT_PER_HOUR=5
# EMAIL_MAX_PER_HOUR=200

# SMTP cũ (tương thích ngược; chỉ dùng khi EMAIL_PROVIDER=smtp hoặc chưa khai EMAIL_PROVIDER):
# ALGOSIM_SMTP_HOST=
# ALGOSIM_SMTP_PORT=587
# ALGOSIM_SMTP_USER=
# ALGOSIM_SMTP_PASSWORD=
# ALGOSIM_SMTP_FROM=
# ALGOSIM_SMTP_STARTTLS=1
