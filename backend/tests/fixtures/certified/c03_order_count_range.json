      {"id": "count_box", "type": "value_box", "value": 0, "label": "Số đơn thỏa mãn"},
      {"id": "ptr", "type": "pointer", "target": "orders_chart", "index": 0, "label": "Xét đơn hàng"}
    ],
    "rules": [],
    "interactions": [],
    "processes": [
      {
        "type": "step_sequence",
        "steps": [
