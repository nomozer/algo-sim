          {"action": "move_pointer", "pointer_id": "ptr", "to_index": 1, "state": "comparing", "narration": "Xét ĐH2 (120k): 80 <= 120 <= 150 (thỏa mãn!), tăng count lên 1."},
          {"action": "highlight", "targets": ["count_box"], "value": 1, "narration": "Đã cập nhật count = 1."},
          {"action": "move_pointer", "pointer_id": "ptr", "to_index": 2, "state": "comparing", "narration": "Xét ĐH3 (85k): 80 <= 85 <= 150 (thỏa mãn!), tăng count lên 2."},
          {"action": "highlight", "targets": ["count_box"], "value": 2, "narration": "Đã cập nhật count = 2."},
          {"action": "move_pointer", "pointer_id": "ptr", "to_index": 3, "narration": "Xét ĐH4 (200k): 200 > 150 (không thỏa), bỏ qua."},
          {"action": "move_pointer", "pointer_id": "ptr", "to_index": 4, "state": "comparing", "narration": "Xét ĐH5 (150k): 80 <= 150 <= 150 (thỏa mãn!), tăng count lên 3."},
          {"action": "highlight", "targets": ["count_box"], "value": 3, "narration": "Đã cập nhật count = 3."},
          {"action": "move_pointer", "pointer_id": "ptr", "to_index": 5, "state": "comparing", "narration": "Xét ĐH6 (90k): 80 <= 90 <= 150 (thỏa mãn!), tăng count lên 4."},
