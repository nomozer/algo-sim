  "defense_in_depth_layers": {
    "layer1_rewrite_contract": {
      "module": "backend/app/ai/slm_verified_normalizer.py",
      "invariants": [
        "polarity_invariance (sentence-wide negation, conditional, dynamic variable, yes/no question, proof goal)",
        "entity_conservation (no hallucinated vertex/solid labels outside original context or explicit Gọi <X> derived point)",
        "quantity_conservation (numeric/symbolic quantities in replacement conserved from original excerpt)",
        "unique_solid_precondition (enforced on VN04_NHAN_IMPLICIT_BASE, VN06_IMPLICIT_*, VN07_IMPLICIT_*, VN12_EDGES_FROM_VERTEX_PAIRWISE_PERP, VN13_PYRAMID_HEIGHT_WITH_FOOT, VN16_BARE_SIMULATION_REQUEST)"
      ],
      "benign_exception": "(không|chưa|đừng|chớ) cần tính (toán)/tìm/giải stripped prior to negation detection so simulation-only tails do not false-trigger"
    },
    "layer2_source_gate": {
      "module": "backend/app/simulation/geometry_functions/registry.py",
      "hardened_checks": [
        "_KHONG_KHANG_DINH: không đúng (là|rằng)?, không phải (cả|mọi|tất cả), sai khi nói/cho rằng (request-exclusion verbs đừng/chớ stay governed by _LOAI_TRU_YEU_CAU -> NEGATED_CLAUSE)",
        "_PHU_DINH_MENH_DE in _phu_dinh: matrix negation across commas on de[ca:vt]",
        "_HOI_QUAN_HE (liệu(?![^,;:?]*\\?)) and _CO_KHONG (liệu): declarative liệu clauses marked QUESTION without shadowing endswith('?') mutant kill",
        "_kiem_mat_chung: preserve AMBIGUOUS_REFERENCE via doc_khang_dinh_loai_hinh before rejecting distinct multi-solid declarations when len(khoi_calls) < 2 (SOURCE_OBJECT_MISMATCH)"
      ]
    },
    "original_source_cross_check": {
      "module": "backend/app/ai/adaptive_input_router.py",
      "function": "_verify_canonical_against_original_source",
      "enforces": [
        "reject LOCAL_V3_ORIGINAL_SOURCE_REJECTED if any non-typography rewrite touched an unsafe original sentence",
        "reject if any served LOCAL_PARSER_AFTER_V3_NORMALIZER premise quote maps back to an unsafe original sentence",
        "never escalate target_solid_disambiguation LOCAL_PARSE_AMBIGUOUS to SLM"
      ]
    }
  },
