+
+export function buildAnalyzeSourceProvenance(
+  state: UnifiedAssistState,
+  selectedCandidateId?: string | null,
+): InputSourceProvenance | undefined {
+  if (state.phase !== "needs_confirmation") return undefined;
+  const p = (state.prepareProvenance ?? {}) as Record<string, unknown>;
+  const rawSha = typeof p.raw_ocr_text_sha256 === "string" ? p.raw_ocr_text_sha256 : null;
+  const regSha = typeof p.prepared_region_sha256 === "string" ? p.prepared_region_sha256 : null;
+  const edited = state.freeEdit || assistCorrectionCount(state) > 0 || state.draftText.trim() !== state.baseText.trim();
+  return {
+    origin: state.usedVlm ? "vision_student_confirmed" : "local_ocr_student_confirmed",
+    raw_ocr_text_sha256: rawSha,
+    prepared_region_sha256: regSha,
+    student_edited: edited,
+    confirmed_span_count: reviewTokens(state.uncertainTokens).length,
+    selected_candidate_id: selectedCandidateId ?? null,
+  };
+}
