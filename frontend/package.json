{
  "name": "algo-sim-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:layout": "node scripts/audit-layout.mjs",
    "test:impact": "node scripts/impact.mjs",
    "test:domain:geometry": "vitest run src/simulations/domains/geometry/",
    "test:domain:semantic": "vitest run src/simulations/domains/semantic/",
    "test:domain:shared-ui": "vitest run src/components/ src/styles/",
    "test:domain:classroom": "vitest run src/state/",
    "test:wave": "vitest run && tsc -b && vite build",
    "test:full": "node scripts/full-gate.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
